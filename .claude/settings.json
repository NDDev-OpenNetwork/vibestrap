{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run *)",
      "Bash(bun install*)",
      "Bash(bun test*)",
      "Bash(bunx --bun *)",
      "Bash(uv run *)",
      "Bash(uv sync*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(rg *)"
    ]
  }
}
